{
  "name": "payslip",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NEXT_TELEMETRY_DISABLED=1 next dev --hostname 127.0.0.1",
    "predev": "prisma db push",
    "build": "prisma generate && cross-env NEXT_TELEMETRY_DISABLED=1 next build",
    "build:e2e": "cross-env PAYSLIP_DIST_DIR=.next-e2e NEXT_TELEMETRY_DISABLED=1 next build",
    "start": "cross-env NEXT_TELEMETRY_DISABLED=1 next start --hostname 127.0.0.1",
    "prestart": "prisma db push",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "reparse:review": "node scripts/reparse-existing.mjs --dry-run",
    "reparse:apply": "node scripts/reparse-existing.mjs --apply",
    "reparse:restore": "node scripts/reparse-existing.mjs --restore-v1",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@napi-rs/canvas": "^0.1.80",
    "@prisma/client": "^6.8.2",
    "@tesseract.js-data/eng": "^1.0.0",
    "lucide-react": "^0.468.0",
    "mailparser": "^3.9.0",
    "next": "^15.3.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tesseract.js": "^6.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@eslint/eslintrc": "^3.2.0",
    "@types/node": "^22.15.3",
    "@types/mailparser": "^3.4.6",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.21",
    "cross-env": "^7.0.3",
    "eslint": "^9.25.1",
    "eslint-config-next": "^15.3.2",
    "prisma": "^6.8.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vitest": "^3.1.2"
  }
}
